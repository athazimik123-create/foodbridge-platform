# ============================================================
# .env.example — FoodBridge Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ── Firebase Admin SDK ────────────────────────────────────────
# Path to your serviceAccountKey.json (downloaded from Firebase Console
# → Project Settings → Service Accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json

# Firebase project ID (e.g. foodbridge-xyz123)
FIREBASE_PROJECT_ID=your-project-id

# ── Firebase Client SDK (Authentication REST API) ─────────────
# Found in Firebase Console → Project Settings → General → Web API Key
FIREBASE_WEB_API_KEY=your-web-api-key

# ── Google Maps API Key ────────────────────────────────────────
# Required for Google Maps embed in Route Optimizer.
# Create at: https://console.cloud.google.com/apis/credentials
# Enable: Maps Embed API, Maps JavaScript API, Directions API
# Without this key the app falls back to folium (OpenStreetMap)
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ── Optional: Full service account as JSON string ─────────────
# Alternative to the file path above (useful for Streamlit Cloud).
# Paste the ENTIRE serviceAccountKey.json content here as a single line:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Razorpay Integration ──────────────────────────────────────
# Generate at: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
